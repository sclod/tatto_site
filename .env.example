# Скопируй в .env и заполни:  cp .env.example .env
# .env в git НЕ попадает (см. .gitignore). Токен бота храни только здесь.

# Адрес сайта без слэша в конце — для превью ссылок, sitemap и проверки заявок
VITE_SITE_URL=https://example.com

# Telegram: токен от @BotFather и id чата, куда слать заявки
# (id узнать:  npm run tg:chat-id  — после того как напишешь боту /start)
BOT_TOKEN=
CHAT_ID=

# Сервер слушает только локально, наружу его отдаёт nginx
PORT=3000
HOST=127.0.0.1
